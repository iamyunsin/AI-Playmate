# ============================================================
# AI Playmate — environment configuration template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── LLM Provider (choose one or leave all blank to use Ollama) ──────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=           # Optional: override for Azure / local proxy
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── Ollama (local, no key needed) ─────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── Embedding (defaults to fastembed local model — no key needed) ──────────
# Set EMBEDDING_PROVIDER=openai to use the OpenAI API instead
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ── Qdrant (vector storage) ───────────────────────────────────────────────
# Leave blank to use in-process embedded Qdrant Edge
QDRANT_URL=
QDRANT_API_KEY=

# ── SurrealDB (graph + session storage) ───────────────────────────────────
# Leave blank to use embedded RocksDB at the path below
SURREALDB_URL=
SURREALDB_USER=root
SURREALDB_PASS=root
SURREALDB_DATA_DIR=./data/surrealdb

# ── Memory system tuning ──────────────────────────────────────────────────
MEMORY_CORE_MAX_TOKENS=2000        # tokens always kept in context
MEMORY_EPISODIC_WINDOW=50          # recent messages kept verbatim
MEMORY_SEMANTIC_TOP_K=10           # max semantic memories injected
MEMORY_ENTITY_TOP_K=5              # max entity-graph results injected
MEMORY_CONSOLIDATION_INTERVAL=300  # seconds between background consolidation

# ── Logging ───────────────────────────────────────────────────────────────
RUST_LOG=info,ai_playmate=debug
